# muse-box backend configuration

# Server
HOST=0.0.0.0
PORT=3000
RUST_LOG=info

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback
TOKEN_STORE_PATH=./data/spotify_token.json
# Embedded music-taste index. Keep it on the same persistent volume as the
# token store, or every redeploy re-embeds the whole library.
TASTE_INDEX_PATH=./data/taste_index.json

# Voice (GPT Realtime)
OPENAI_API_KEY=your_openai_key
# Turns a transcript into one tool call, over stateless chat completions. This
# is the path the browser uses and the one that has to be reliable.
OPENAI_INTENT_MODEL=gpt-4o
# Muse's spoken replies.
OPENAI_SPEECH_MODEL=tts-1-hd
OPENAI_SPEECH_VOICE=alloy
# Only used by the audio path, which hardware uses.
OPENAI_REALTIME_MODEL=gpt-realtime

# Idle clock: minutes east of UTC for the displayed HH:MM (e.g. 330 for IST,
# -300 for EST). Scheduling stays on UTC minute boundaries.
IDLE_UTC_OFFSET_MINUTES=0

# Browser origins allowed to call the API, comma separated. Leave empty to
# allow any origin (auth is a bearer token, not a cookie, so there is no
# ambient credential to ride on). Set it once the frontend has a real domain.
CORS_ALLOWED_ORIGINS=

# Device auth
DEVICE_API_TOKEN=change_me_in_production
