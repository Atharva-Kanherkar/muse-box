# muse-box backend configuration

# Server
HOST=0.0.0.0
PORT=3000
RUST_LOG=info

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback

# Multi-tenant: each account that completes OAuth gets its own subdirectory
# here (own token, own taste index). Whoever completes OAuth first — or
# whoever TOKEN_STORE_PATH/TASTE_INDEX_PATH below belonged to on a pre-existing
# single-tenant install — becomes the "owner" account, recorded in
# OWNER_MARKER_PATH; the hardware DEVICE_API_TOKEN always resolves to them.
ACCOUNTS_ROOT=./data/accounts
OWNER_MARKER_PATH=./data/owner_account_id.txt

# Read only once, at boot, to migrate a pre-multi-tenant install: if
# ACCOUNTS_ROOT does not exist yet and a token is found here, it is moved into
# ACCOUNTS_ROOT under that account's own Spotify user id. Irrelevant on a
# fresh install.
TOKEN_STORE_PATH=./data/spotify_token.json
TASTE_INDEX_PATH=./data/taste_index.json

# Voice (GPT Realtime)
OPENAI_API_KEY=your_openai_key
# Turns a transcript into one tool call, over stateless chat completions. This
# is the path the browser uses and the one that has to be reliable.
OPENAI_INTENT_MODEL=gpt-5.6-terra
# Muse's spoken replies.
# gpt-4o-mini-tts is the current speech model; tts-1 and tts-1-hd are the older
# ones. Voices: alloy ash ballad coral echo fable nova onyx sage shimmer verse
# marin cedar.
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=cedar
# Only used by the audio path, which hardware uses.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Idle clock: minutes east of UTC for the displayed HH:MM (e.g. 330 for IST,
# -300 for EST). Scheduling stays on UTC minute boundaries.
IDLE_UTC_OFFSET_MINUTES=0

# Browser origins allowed to call the API, comma separated. Leave empty to
# allow any origin (auth is a bearer token, not a cookie, so there is no
# ambient credential to ride on). Set it once the frontend has a real domain.
CORS_ALLOWED_ORIGINS=

# Device auth
DEVICE_API_TOKEN=change_me_in_production
